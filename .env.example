# GEMINI_API_KEY: Clé API Google AI Studio pour Gemini (Gratuit sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="VOTRE_CLE_API_GEMINI"

# PORT: Port d'écoute du serveur local (par défaut 3000)
PORT=3000

# APP_URL: URL du serveur (en local: http://localhost:3000)
APP_URL="http://localhost:3000"
